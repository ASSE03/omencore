<UserControl x:Class="OmenCore.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OmenCore.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OmenCore.Views"
             xmlns:utils="clr-namespace:OmenCore.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <ScrollViewer Style="{StaticResource SmoothScrollViewer}" 
                  Padding="0,0,12,0">
        <StackPanel Margin="20,20,20,40">
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{x:Static loc:Strings.UiSystemDiagnostics}" Style="{StaticResource Heading1}"/>
                <TextBlock Text="{x:Static loc:Strings.UiHardwareTestingAndValidationTools}" 
                           Style="{StaticResource Caption}"
                           Opacity="0.9"/>
            </StackPanel>

            <!-- Side-by-side diagnostics panels (GitHub #48 - kg290: combine diagnostics side-by-side) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Fan Diagnostics (Left) -->
                <GroupBox Grid.Column="0" Header="{x:Static loc:Strings.UiFanDiagnostics}" Style="{StaticResource ModernGroupBox}">
                    <views:FanDiagnosticsView DataContext="{Binding FanDiagnostics}" />
                </GroupBox>

                <!-- Keyboard Lighting Diagnostics (Right) -->
                <GroupBox Grid.Column="2" Header="{x:Static loc:Strings.UiKeyboardLightingDiagnostics}" Style="{StaticResource ModernGroupBox}">
                    <views:KeyboardDiagnosticsView DataContext="{Binding KeyboardDiagnostics}" />
                </GroupBox>
            </Grid>

            <!-- Monitoring Diagnostics (new for v3.0.0) -->
            <GroupBox Header="{x:Static loc:Strings.UiMonitoringDiagnostics}" Style="{StaticResource ModernGroupBox}" Margin="0,12,0,0">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="{x:Static loc:Strings.UiHealth}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Dashboard.MonitoringHealthStatusText}" FontSize="13" Margin="0,0,0,6" />

                        <TextBlock Text="{x:Static loc:Strings.UiSource}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Dashboard.MonitoringSourceText}" FontSize="13" Margin="0,0,0,6" />

                        <TextBlock Text="{x:Static loc:Strings.UiLastSampleAge}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Dashboard.LastSampleAge}" FontSize="13" Margin="0,0,0,6" />

                        <TextBlock Text="{x:Static loc:Strings.UiConsecutiveTimeouts}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding HardwareMonitoringService.ConsecutiveTimeouts}" FontSize="13" Margin="0,0,0,6" />

                        <TextBlock Text="{x:Static loc:Strings.UiCPUTempOverride}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding CpuTempOverrideDiagnosticText}" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{x:Static loc:Strings.UiExportDiagnostics_aa481}" Command="{Binding Settings.ExportDiagnosticsCommand}" Style="{StaticResource AccentButtonSmall}" Margin="0,0,8,0"
                                    ToolTip="{x:Static loc:Strings.UiSaveTheFullCoreControlReadinessReport}"
                                    AutomationProperties.Name="{x:Static loc:Strings.UiExportFullDiagnosticsReport}" />
                            <Button Content="{x:Static loc:Strings.UiExportTelemetry}" Command="{Binding ExportTelemetryCommand}" Style="{StaticResource AccentButtonSmall}" Margin="0,0,8,0" ToolTip="{x:Static loc:Strings.UiCreateACopyOfTheTelemetryJSON}"
                                    AutomationProperties.Name="{x:Static loc:Strings.UiExportTelemetryJSON}" />
                            <Button Content="{x:Static loc:Strings.UiReportModel}" Command="{Binding ReportModelCommand}" Style="{StaticResource OutlineButtonSmall}" ToolTip="{x:Static loc:Strings.UiCreateDiagnosticsBundleAndCopyModelInfo}"
                                    AutomationProperties.Name="{x:Static loc:Strings.UiReportThisModelToTheMaintainer}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock Text="{x:Static loc:Strings.UiActiveAlerts_817ae}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{x:Static loc:Strings.UiBackend}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding HardwareMonitoringService.MonitoringSource}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Text="{x:Static loc:Strings.UiWorkerTimeouts}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding HardwareMonitoringService.ConsecutiveTimeouts}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Text="{x:Static loc:Strings.UiQuickActions}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <Button Content="{x:Static loc:Strings.UiOpenAppLogsFolder}" Click="OpenDiagnosticsFolder_Click" Style="{StaticResource OutlineButtonSmall}" Margin="0,0,0,8"
                                ToolTip="{x:Static loc:Strings.UiOpenTheFolderContainingOmenCoreSLog}"
                                AutomationProperties.Name="{x:Static loc:Strings.UiOpenAppLogsFolder}" />
                        <Button Content="{x:Static loc:Strings.UiOpenOmenCoreDataFolder}" Click="OpenOmenCoreDataFolder_Click" Style="{StaticResource OutlineButtonSmall}"
                                ToolTip="{x:Static loc:Strings.UiOpenTheFolderContainingOmenCoreSConfig}"
                                AutomationProperties.Name="{x:Static loc:Strings.UiOpenOmenCoreDataFolder}" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Temperature Source Comparison: "does this temperature look right?" A user with a
                 wrong-looking reading previously had no way to see WMI BIOS / ACPI Thermal Zone /
                 LibreHardwareMonitor side by side without a maintainer reading raw logs by hand. -->
            <GroupBox Header="{x:Static loc:Strings.UiTemperatureSourceComparison}" Style="{StaticResource ModernGroupBox}" Margin="0,12,0,0"
                      Visibility="{Binding TemperatureSourceDiagnostics.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="8">
                    <TextBlock Text="{x:Static loc:Strings.UiReadsEveryCPUTemperatureSourceOmenCoreKnows}"
                               FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Content="{Binding TemperatureSourceDiagnostics.RunButtonLabel}"
                            Command="{Binding TemperatureSourceDiagnostics.RunComparisonCommand}"
                            Style="{StaticResource OutlineButtonSmall}" HorizontalAlignment="Left"
                            ToolTip="{x:Static loc:Strings.UiReadWMIBIOSACPIAndLibreHardwareMonitorCPU}"
                            AutomationProperties.Name="{x:Static loc:Strings.UiRunTemperatureSourceComparison}"/>

                    <Border Background="#2D2D1F" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                            Visibility="{Binding TemperatureSourceDiagnostics.SourcesDisagree, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding TemperatureSourceDiagnostics.Result}" FontSize="12" FontFamily="{StaticResource MonospaceFontFamily}"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding TemperatureSourceDiagnostics.Result}" FontSize="12" FontFamily="{StaticResource MonospaceFontFamily}"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding TemperatureSourceDiagnostics.SourcesDisagree, Converter={StaticResource InverseBoolToVisibility}}"/>
                </StackPanel>
            </GroupBox>

            <!-- Power adapter (Legacy 0x0F). Hidden entirely on boards that don't report it, rather
                 than shown empty. Read-only: nothing here writes to the firmware. -->
            <GroupBox Header="{x:Static loc:Strings.UiPowerAdapter}" Style="{StaticResource ModernGroupBox}" Margin="0,12,0,0"
                      Visibility="{Binding GpuClamp.HasPowerAdapterInfo, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static loc:Strings.UiConnectedAdapter}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding GpuClamp.PowerAdapterSummary}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{x:Static loc:Strings.UiShippedWith}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding GpuClamp.PowerAdapterRequirement}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#2D2D1F" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding GpuClamp.HasPowerAdapterExplanation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding GpuClamp.PowerAdapterExplanation}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- The override. Offered only on an under-rated supply, because on one that meets
                         the requirement there is no clamp to discard and this would cost a black
                         screen for nothing. Confirmation lives in the click handler, not here. -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding GpuClamp.CanOfferAdapterOverride, Converter={StaticResource BoolToVisibility}}">
                        <Separator Margin="0,0,0,10"/>

                        <!-- The reading goes above the button, not below it: the point is to answer
                             "is anything actually clamped here" before someone pays a black screen
                             to find out. -->
                        <TextBlock Text="{x:Static loc:Strings.UiCurrentGPUPowerLimit}" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                        <TextBlock Text="{Binding GpuClamp.GpuPowerLimitSummary}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding GpuClamp.HasGpuPowerLimitReading, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding GpuClamp.GpuPowerLimitAttribution}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GpuClamp.HasGpuPowerLimitAttribution, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding GpuClamp.GpuPowerLimitPrompt}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GpuClamp.HasGpuPowerLimitPrompt, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="{Binding GpuClamp.CheckGpuPowerLimitLabel}"
                                Command="{Binding GpuClamp.CheckGpuPowerLimitCommand}"
                                Style="{StaticResource OutlineButtonSmall}" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                ToolTip="{x:Static loc:Strings.UiReadTheGPUSCurrentPowerLimit}"
                                AutomationProperties.Name="{x:Static loc:Strings.UiCheckCurrentGPUPowerLimit}"/>

                        <Separator Margin="0,12,0,10"/>

                        <TextBlock Text="{x:Static loc:Strings.UiDropTheAdapterPowerClamp}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{x:Static loc:Strings.UiTheFirmwareTellsTheGPUDriverAbout}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{x:Static loc:Strings.UiTheSameSupplyClampsTheCPUBy}"/>
                        <TextBlock Text="{Binding GpuClamp.AdapterOverrideScope}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Visibility="{Binding GpuClamp.HasAdapterOverrideScope, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="{x:Static loc:Strings.UiYourScreensWillGoBlackForA}"/>

                        <Button Content="{x:Static loc:Strings.UiDropTheClamp}"
                                Click="ApplyAdapterOverride_Click"
                                IsEnabled="{Binding GpuClamp.CanApplyAdapterOverride}"
                                Style="{StaticResource OutlineButtonSmall}" Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                ToolTip="{x:Static loc:Strings.UiRestartsTheGPUDeviceToForceThe}"
                                AutomationProperties.Name="{x:Static loc:Strings.UiDropTheAdapterPowerClamp}"/>

                        <TextBlock Text="{Binding GpuClamp.ApuClampStatus}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GpuClamp.HasApuClampStatus, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Content="{x:Static loc:Strings.UiStopHoldingTheCPULimits}"
                                Command="{Binding GpuClamp.ReleaseApuClampCommand}"
                                Style="{StaticResource OutlineButtonSmall}" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding GpuClamp.IsApuClampHeld, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{x:Static loc:Strings.UiReleaseTheAMDSMUPowerLimitsOmenCore}"
                                AutomationProperties.Name="{x:Static loc:Strings.UiStopHoldingTheCPUPowerLimits}"/>

                        <!-- Doing it without being asked every boot. Both off by default; the GPU one
                             carries its condition in the label, because that condition is the only
                             reason it can be automatic at all. -->
                        <Separator Margin="0,12,0,10"/>

                        <TextBlock Text="{x:Static loc:Strings.UiDoThisOnItsOwn}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <CheckBox IsChecked="{Binding GpuClamp.AutoLiftCpuLimits}" Margin="0,8,0,0"
                                  Content="{x:Static loc:Strings.UiKeepTheCPUPowerLimitsRaised}"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="22,2,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="{x:Static loc:Strings.UiAppliedAtStartupAfterAResumeAnd}"/>

                        <CheckBox IsChecked="{Binding GpuClamp.AutoLiftGpuWhenParked}" Margin="0,10,0,0"
                                  Content="{x:Static loc:Strings.UiRestartTheGPUToDropItsClamp}"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="22,2,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="{x:Static loc:Strings.UiOnlyWhenTheDriverHasParkedThe}"/>

                        <TextBlock Text="{Binding GpuClamp.AutoClampLiftStatus}" FontSize="11" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GpuClamp.HasAutoClampLiftStatus, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding GpuClamp.AdapterOverrideBlockedReason}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GpuClamp.HasAdapterOverrideBlockedReason, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding GpuClamp.AdapterOverrideStatus}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GpuClamp.HasAdapterOverrideStatus, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <TextBlock Text="{x:Static loc:Strings.UiReadFromTheBIOSEachTimeThis}"
                               FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <!-- The board-8D87-only GPU TGP unlock. A different, higher-risk mechanism from
                         the adapter override above (EC bits the firmware actively reasserts, not a
                         driver restart), so it gets its own, more explicit risk block rather than
                         living inside the section above it. Not confirmed on real hardware. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding GpuClamp.CanOfferGpuTgpUnlock, Converter={StaticResource BoolToVisibility}}">
                        <Separator Margin="0,0,0,10"/>
                        <TextBlock Text="{x:Static loc:Strings.UiGPUPowerUnlockExperimentalBoard8D87Only}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{x:Static loc:Strings.UiThisBoardSGPUIsHeldUnder}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                                   Text="{x:Static loc:Strings.UiNotConfirmedOnRealHardwareForcingThis}"/>
                        <TextBlock Text="{Binding GpuClamp.GpuTgpUnlockStatus}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GpuClamp.HasGpuTgpUnlockStatus, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="{x:Static loc:Strings.UiTryTheGPUPowerUnlock}"
                                Click="EngageGpuTgpUnlock_Click"
                                IsEnabled="{Binding GpuClamp.CanEngageGpuTgpUnlock}"
                                Style="{StaticResource OutlineButtonSmall}" Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                ToolTip="{x:Static loc:Strings.UiExperimentalPinsTwoECBitsAndFires}"
                                AutomationProperties.Name="{x:Static loc:Strings.UiTryTheGPUPowerUnlockExperimental}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Model Capabilities (what this specific detected model does/doesn't support) -->
            <GroupBox Header="{x:Static loc:Strings.UiModelCapabilities}" Style="{StaticResource ModernGroupBox}" Margin="0,12,0,0">
                <StackPanel Margin="8">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DetectedCapabilities.ModelConfig.ModelName, FallbackValue='Unknown model'}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0">
                                <Run Text="{x:Static loc:Strings.UiProductID}"/>
                                <Run Text="{Binding DetectedCapabilities.ProductId, FallbackValue='?'}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                                Background="#1A00FF88"
                                Visibility="{Binding DetectedCapabilities.ModelConfig.UserVerified, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static loc:Strings.UiUserVerifiedProfile}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                                Background="#1AFF9800"
                                Visibility="{Binding DetectedCapabilities.ModelConfig.UserVerified, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{x:Static loc:Strings.UiInferredNotYetVerified}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Notes / quirks for this model, when present -->
                    <Border Background="#2D2D1F" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding DetectedCapabilities.ModelConfig.Notes, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding DetectedCapabilities.ModelConfig.Notes}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{x:Static loc:Strings.UiThisReflectsWhatOmenCoreSModelDatabase}"
                               FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <UniformGrid Columns="2">
                        <Border Background="#0D0D0F" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.UiCustomFanCurves}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{x:Static loc:Strings.UiSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsFanCurves, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{x:Static loc:Strings.UiNotSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsFanCurves, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#0D0D0F" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.UiIndependentCPUGPUFanCurves}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{x:Static loc:Strings.UiSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsIndependentFanCurves, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{x:Static loc:Strings.UiNotSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsIndependentFanCurves, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#0D0D0F" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.UiRealFanRPMReadback}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding RpmReadbackLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Background="#0D0D0F" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.UiGPUMUXSwitch}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{x:Static loc:Strings.UiPresent}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.HasMuxSwitch, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{x:Static loc:Strings.UiNotPresent}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.HasMuxSwitch, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#0D0D0F" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.UiGPUPowerBoostTGP}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{x:Static loc:Strings.UiSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsGpuPowerBoost, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{x:Static loc:Strings.UiNotSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsGpuPowerBoost, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#0D0D0F" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.UiAdvancedOptimusGPUSwitching}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{x:Static loc:Strings.UiSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsAdvancedOptimus, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{x:Static loc:Strings.UiNotSupported}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Visibility="{Binding DetectedCapabilities.ModelConfig.SupportsAdvancedOptimus, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

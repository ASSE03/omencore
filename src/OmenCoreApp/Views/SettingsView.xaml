                                <TextBlock Text="{x:Static loc:Strings.SettingsHeadlessModeHelp}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding HeadlessMode, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static loc:Strings.SettingsHeadlessMode}"/>
                        </Grid>

                        <!-- Software Rendering (RTSS / overlay compatibility) -->

                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider AutomationProperties.Name="{x:Static loc:Strings.UiStartupSafeModeTimeoutThreshold}" Minimum="1" Maximum="10"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding StartupSafeModeTimeoutThreshold}"
                                        Width="130" VerticalAlignment="Center"
                                        IsEnabled="{Binding StartupSafeModeGuardEnabled}"/>
                                <TextBlock Text="{Binding StartupSafeModeTimeoutThreshold, StringFormat={}{0}}"
                                           FontSize="12" Width="70" TextAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hardware Worker Settings -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="M9 3V5H7V3H9M11 3V5H13V3H11M9 7V9H7V7H9M11 7V9H13V7H11M9 11V13H7V11H9M11 11V13H13V11H11M15 3H17V5H15V3M15 7H17V9H15V7M15 11H17V13H15V11M3 3H5V5H3V3M3 7H5V9H3V7M3 11H5V13H3V11M21 11V19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V11C3 9.9 3.9 9 5 9H19C20.1 9 21 9.9 21 11M19 11H5V19H19V11Z"
                                  Fill="#81C784"
                                  Width="24" Height="24" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{x:Static loc:Strings.UiHardwareWorker}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Orphan Timeout Enabled -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiEnableOrphanTimeout}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiWorkerProcessExitsAfterMainAppCloses}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding HardwareWorkerOrphanTimeoutEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static loc:Strings.UiEnableOrphanTimeout}"/>
                        </Grid>

                        <!-- Orphan Timeout Minutes -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiOrphanTimeoutDuration}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiMinutesToWaitForReconnectionBeforeWorker}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

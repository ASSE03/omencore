                                        <TextBlock Text="{x:Static loc:Strings.UiCPUClock}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <ToggleButton AutomationProperties.Name="{x:Static loc:Strings.UiCPUClock}" Style="{StaticResource ModernToggleButton}" IsChecked="{Binding OsdShowCpuClock}"/>
                                    </StackPanel>

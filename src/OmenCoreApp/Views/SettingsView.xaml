                                <TextBlock Text="{x:Static loc:Strings.SettingsReduceMotion}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsReduceMotionHelp}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

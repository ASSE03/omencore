                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding UiScaleOptions}"
                                      ItemStringFormat="{}{0}%"
                                      SelectedItem="{Binding UiScalePercent, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static loc:Strings.SettingsDisplayScale}"/>
                        </Grid>

                        <!-- Minimize to Tray on Close -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsMinimizeToTray}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsMinimizeToTrayHelp}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding MinimizeToTrayOnClose}"
                                          AutomationProperties.Name="{x:Static loc:Strings.SettingsMinimizeToTray}"/>
                        </Grid>

                        <!-- Stay on Top -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsStayOnTop}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsStayOnTopHelp}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A00C8C8" CornerRadius="4" Padding="8,4" Margin="0,0,10,0"
                                        Visibility="{Binding StayOnTop, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Static loc:Strings.SettingsActiveBadge}" FontSize="11" Foreground="#00C8C8" FontWeight="SemiBold"/>
                                </Border>
                                <ToggleButton AutomationProperties.Name="{x:Static loc:Strings.SettingsStayOnTop}" Style="{StaticResource ModernToggleButton}"
                                              IsChecked="{Binding StayOnTop}"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.6" Margin="0,4,0,16"/>

                        <TextBlock Text="{x:Static loc:Strings.SettingsTrayAndUi}" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Quick Access middle shortcut -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsQuickAccess}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsQuickAccessHelp}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding QuickAccessActionOptions}"
                                      SelectedItem="{Binding QuickAccessAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static loc:Strings.SettingsQuickAccess}"/>
                        </Grid>

                        <!-- Enable/Disable Quick Access popup entirely -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsQuickPopup}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsQuickPopupHelp}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton AutomationProperties.Name="{x:Static loc:Strings.SettingsQuickPopup}" Grid.Column="1"
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding QuickPopupEnabled}"/>
                        </Grid>

                        <!-- Show Temperature on Tray Icon -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsTrayTemperature}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsTrayTemperatureHelp}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding TrayTempDisplayEnabled}"
                                          AutomationProperties.Name="{x:Static loc:Strings.SettingsTrayTemperature}"/>
                        </Grid>

                        <!-- Corsair HID-only mode (Disable iCUE fallback) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsCorsairHidOnly}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsCorsairHidOnlyHelp}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding CorsairDisableIcueFallback, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static loc:Strings.SettingsCorsairHidOnly}"/>
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.SettingsCorsairHidOnlyWarning}" 
                                   FontSize="12" Foreground="#FFB74D" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding CorsairDisableIcueFallback, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Telemetry opt-in -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsTelemetry}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsTelemetryHelp}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding TelemetryEnabled, Mode=TwoWay}" 
                                          ToolTipService.ToolTip="{x:Static loc:Strings.UiShareAnonymousPIDSuccessFailureCountsTo}"
                                          AutomationProperties.Name="{x:Static loc:Strings.SettingsTelemetry}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static loc:Strings.UiAdvanced}">
                <ScrollViewer Style="{StaticResource SmoothScrollViewer}" Padding="0,0,12,0">
                    <StackPanel Margin="20,20,20,40">

                <!-- Monitoring Settings -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconMonitoring}" 
                                  Fill="#4FC3F7" 
                                  Width="24" Height="24" Stretch="Uniform" 
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{x:Static loc:Strings.UiMonitoring}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Automatic Cadence Policy -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiAutomaticMonitoringCadence}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiOmenCoreNowOwnsCadenceAutomaticallyActiveWindows}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiCadenceTiers}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.Ui1sWhenTheUIOrOSDNeeds}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- History Length -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiChartHistory}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiNumberOfDataPointsToDisplayIn}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider AutomationProperties.Name="{x:Static loc:Strings.UiHistoryCount}" Minimum="30" Maximum="300" 
                                        TickFrequency="30"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding HistoryCount}"
                                        Width="120" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HistoryCount, StringFormat={}{0} points}" 
                                           FontSize="12" Width="60" TextAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Low Overhead Mode -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiLowOverheadMode}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiReduceCPUUsageByLimitingSensorPolling}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding LowOverheadMode}"
                                          AutomationProperties.Name="{x:Static loc:Strings.UiLowOverheadMode}"/>
                        </Grid>

                        <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="#141A20" BorderBrush="#22303C" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.UiLiveCadenceStatus}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4">
                                    <Run Text="{x:Static loc:Strings.UiCurrentTier}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding MonitoringCadenceTier, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                                    <Run Text="{x:Static loc:Strings.UiReason}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding MonitoringCadenceReason, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="{x:Static loc:Strings.UiUltraLowBlockers}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding MonitoringCadenceBlockers, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Startup Safe Mode Guard -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiStartupSafeModeGuard}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiTemporarilyBlocksTrayWriteActionsIfMonitoring}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding StartupSafeModeGuardEnabled}"
                                          AutomationProperties.Name="{x:Static loc:Strings.UiStartupSafeModeGuard}"/>
                        </Grid>

                        <!-- Safe Mode Guard Window -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiSafeModeStartupWindow}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiHowLongAfterStartupTheGuardCan}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider AutomationProperties.Name="{x:Static loc:Strings.UiStartupSafeModeWindowSeconds}" Minimum="30" Maximum="600"
                                        TickFrequency="30"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding StartupSafeModeWindowSeconds}"
                                        Width="130" VerticalAlignment="Center"
                                        IsEnabled="{Binding StartupSafeModeGuardEnabled}"/>
                                <TextBlock Text="{Binding StartupSafeModeWindowSeconds, StringFormat={}{0}s}"
                                           FontSize="12" Width="70" TextAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Safe Mode Timeout Threshold -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                </Border>

                <!-- Battery Care Settings -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🔋" FontSize="24" 
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.UiBatteryCare}" FontSize="20" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiExtendBatteryLifespanWithSmartChargeLimiting}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Enable/Disable Charge Limit -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiEnableChargeLimit}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiStopChargingAtACustomThresholdTo}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding BatteryChargeLimitEnabled}"
                                          AutomationProperties.Name="{x:Static loc:Strings.UiEnableChargeLimit}"/>
                        </Grid>

                        <!-- Charge Threshold Slider (shown when enabled) -->
                        <Border Background="#1A6B4C9A" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding BatteryChargeLimitEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.UiChargeThreshold}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{x:Static loc:Strings.UiSetMaximumBatteryChargeLevel}" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider AutomationProperties.Name="{x:Static loc:Strings.UiBatteryChargeThresholdPercent}" Minimum="60" Maximum="100" 
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding BatteryChargeThresholdPercent}"
                                            Width="80" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BatteryChargeThresholdPercent, StringFormat={}{0}%}" 
                                               FontSize="16" FontWeight="Bold" Width="50" TextAlignment="Right"
                                               Foreground="#81C784"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Info Banner -->
                        <Border Background="#1A4CAF50" CornerRadius="4" Padding="12" Margin="0,0,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run FontWeight="SemiBold" Foreground="#81C784">💡 Battery Health Tips:</Run>
                                <LineBreak/>
                                • <Run FontWeight="SemiBold">80%</Run> is recommended for daily use (doubles battery lifespan)
                                <LineBreak/>
                                • <Run FontWeight="SemiBold">60-70%</Run> for maximum longevity if always plugged in
                                <LineBreak/>
                                • <Run FontWeight="SemiBold">100%</Run> when you need full capacity for travel
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Fan Hysteresis Settings -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🌀" FontSize="24" 
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.UiFanHysteresis}" FontSize="20" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiPreventFanSpeedOscillationWithDeadZone}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Enable -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.UiEnableHysteresis}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.UiSmoothOutFanSpeedChangesToReduce}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding FanHysteresisEnabled}"
                                          AutomationProperties.Name="{x:Static loc:Strings.UiEnableHysteresis}"/>
                        </Grid>

                        <Border Background="#1A6B4C9A" CornerRadius="8" Padding="16" 
                                IsEnabled="{Binding FanHysteresisEnabled}">
                            <StackPanel>
                                <!-- Dead Zone -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.UiTemperatureDeadZone}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.UiFansWonTChangeUnlessTempMoves}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.UiFanHysteresisDeadZone}" Text="{Binding FanHysteresisDeadZone, StringFormat=F1}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,0,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ramp Up Delay -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.UiRampUpDelay}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.UiWaitBeforeIncreasingFanSpeed}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.UiFanHysteresisRampUpDelay}" Text="{Binding FanHysteresisRampUpDelay, StringFormat=F1}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ramp Down Delay -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.UiRampDownDelay}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.UiWaitBeforeDecreasingFanSpeed}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.UiFanHysteresisRampDownDelay}" Text="{Binding FanHysteresisRampDownDelay, StringFormat=F1}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Thermal Protection Enable/Disable Toggle -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.UiThermalProtection}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.UiAutoBoostFansWhenTempsExceedThreshold}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource ModernToggleButton}"
                                                  IsChecked="{Binding ThermalProtectionEnabled}"
                                                  AutomationProperties.Name="{x:Static loc:Strings.UiThermalProtection_72d13}"/>
                                </Grid>

                                <!-- Thermal Protection Threshold -->
                                <Grid Margin="0,12,0,0"
                                      IsEnabled="{Binding ThermalProtectionEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.UiThermalProtectionThreshold}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.UiFansRampUpWhenTempsExceedThis}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ThermalProtectionThreshold, StringFormat=F0}"
                                                 Width="50" Padding="6,4" TextAlignment="Right"
                                                 AutomationProperties.Name="{x:Static loc:Strings.UiThermalProtectionRampThresholdInCelsius}"/>
                                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Thermal Emergency Threshold -->
                                <Grid Margin="0,12,0,0"
                                      IsEnabled="{Binding ThermalProtectionEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.UiEmergencyMaxFanThreshold}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.UiFansForcedTo100ImmediatelyAboveThis}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ThermalEmergencyThreshold, StringFormat=F0}"
                                                 Width="50" Padding="6,4" TextAlignment="Right"
                                                 AutomationProperties.Name="{x:Static loc:Strings.UiEmergencyMaxFanThresholdInCelsius}"/>
                                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Max Fan Level Override -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.UiMaxFanLevelOverride}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.UiOverrideAutoDetectedMaxFanLevelSet}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.UiMaxFanLevelOverride}" Text="{Binding MaxFanLevelOverride, StringFormat=F0}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- HP Omen Gaming Hub Cleanup (only show when OGH is installed) -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        Visibility="{Binding OghInstalled, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding DataContext.SystemControl.Maintenance, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                                  Fill="OrangeRed" 
                                  Width="24" Height="24" Stretch="Uniform" 
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{x:Static loc:Strings.UiHPOMENGamingHubCleanup}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" TextWrapping="Wrap">
                            <Run Text="{x:Static loc:Strings.UiRemoveHPOMENGamingHubAndRelated}"/>
                        </TextBlock>
                        
                        <TextBlock FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap">
                            <Run Text="{x:Static loc:Strings.UiASystemRestorePointWillBeCreated}" FontWeight="Bold" Foreground="#4CAF50"/>
                        </TextBlock>

                        <!-- Cleanup Options -->
                        <StackPanel Margin="0,0,0,16">
